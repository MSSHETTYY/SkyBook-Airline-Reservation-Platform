{
  "info": {
    "name": "SkyBook API - booking saga end to end",
    "description": "Black-box tests through the api-gateway: auth, search, seat map, idempotent booking, payment (fake provider), ticketing, cancellation with refund, and the error contract (401/403/400). Run: newman run tests/api/skybook.postman_collection.json -e tests/api/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "flightId",
      "value": ""
    },
    {
      "key": "seat",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "bookingReference",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "travelDate",
      "value": ""
    },
    {
      "key": "attempts",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Auth",
      "item": [
        {
          "name": "Customer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/skybook/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "skybook-test-client"
                },
                {
                  "key": "username",
                  "value": "customer@skybook.test"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/skybook/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "skybook-test-client"
                },
                {
                  "key": "username",
                  "value": "admin@skybook.test"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Inventory",
      "item": [
        {
          "name": "Search flights (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/flights?origin=DXB&destination=LHR&date={{travelDate}}&passengers=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with at least one flight', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('answers within 1 s (latency SLOs are measured with k6)', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test('correlation id echoed', () => pm.response.to.have.header('X-Correlation-Id'));",
                  "pm.collectionVariables.set('flightId', pm.response.json()[0].flightId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 10 * 86400000);",
                  "pm.collectionVariables.set('travelDate', d.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Seat map",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/flights/{{flightId}}/seats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const free = pm.response.json().seats.filter(s => s.available && s.cabinClass === 'ECONOMY');",
                  "pm.test('free economy seats exist', () => pm.expect(free).to.not.be.empty);",
                  "pm.collectionVariables.set('seat', free[free.length - 1].seatNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search rejects a malformed airport code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/flights?origin=D1&destination=LHR&date={{travelDate}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('RFC 9457 problem with a stable code and a correlation id', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const problem = pm.response.json();",
                  "  pm.expect(problem.code).to.be.a('string');",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Booking saga",
      "item": [
        {
          "name": "Create booking without a token is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\"flightId\": {{flightId}}, \"contactEmail\": \"x@example.test\", \"passengers\": []}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 9457 problem with a stable code and a correlation id', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const problem = pm.response.json();",
                  "  pm.expect(problem.code).to.be.a('string');",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": {{flightId}},\n  \"contactEmail\": \"customer@skybook.test\",\n  \"passengers\": [\n    {\n      \"firstName\": \"Ada\",\n      \"lastName\": \"Lovelace\",\n      \"dateOfBirth\": \"1990-12-10\",\n      \"seatNumber\": \"{{seat}}\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 awaiting payment', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT');",
                  "  pm.expect(pm.response.json().holdExpiresAt).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('bookingReference', pm.response.json().bookingReference);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry with the same Idempotency-Key returns the same booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": {{flightId}},\n  \"contactEmail\": \"customer@skybook.test\",\n  \"passengers\": [\n    {\n      \"firstName\": \"Ada\",\n      \"lastName\": \"Lovelace\",\n      \"dateOfBirth\": \"1990-12-10\",\n      \"seatNumber\": \"{{seat}}\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('same reference, no second booking', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  pm.expect(pm.response.json().bookingReference).to.eql(pm.collectionVariables.get('bookingReference'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for the payment to be attached",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (!(json.payment && json.payment.paymentId) && attempts < 30) {",
                  "  pm.collectionVariables.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('attempts', 0);",
                  "pm.test('payment attached', () => pm.expect(json.payment.paymentId).to.match(/^pay_/));",
                  "pm.collectionVariables.set('paymentId', json.payment.paymentId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (attempts > 0) { setTimeout(() => {}, 1000); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay (fake provider simulation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/simulation",
            "body": {
              "mode": "raw",
              "raw": "{\"outcome\": \"SUCCEEDED\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until ticketed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (!(json.status === 'CONFIRMED' || json.status === 'FAILED') && attempts < 30) {",
                  "  pm.collectionVariables.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('attempts', 0);",
                  "pm.test('confirmed with ticket numbers', () => {",
                  "  pm.expect(json.status).to.eql('CONFIRMED');",
                  "  json.passengers.forEach(p => pm.expect(p.ticketNumber).to.be.a('string'));",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (attempts > 0) { setTimeout(() => {}, 1000); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer cannot use the admin API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('RFC 9457 problem with a stable code and a correlation id', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const problem = pm.response.json();",
                  "  pm.expect(problem.code).to.be.a('string');",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin finds the booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings?status=CONFIRMED&size=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const refs = pm.response.json().items.map(b => b.bookingReference);",
                  "  pm.expect(refs).to.include(pm.collectionVariables.get('bookingReference'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Cancellation",
      "item": [
        {
          "name": "Cancellation quote: full refund 10 days out",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}/cancellation-quote"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('100%', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().refundPercentage).to.eql(100);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}/cancellation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 accepted', () => {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.json().status).to.be.oneOf(['CANCELLATION_PENDING', 'CANCELLED']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until refunded",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (!(json.status === 'CANCELLED') && attempts < 30) {",
                  "  pm.collectionVariables.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('attempts', 0);",
                  "pm.test('cancelled and refunded', () => {",
                  "  pm.expect(json.status).to.eql('CANCELLED');",
                  "  pm.expect(json.amountRefunded.amount).to.eql(json.amountPaid.amount);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "if (attempts > 0) { setTimeout(() => {}, 1000); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelling twice is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}/cancellation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('RFC 9457 problem with a stable code and a correlation id', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const problem = pm.response.json();",
                  "  pm.expect(problem.code).to.be.a('string');",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
