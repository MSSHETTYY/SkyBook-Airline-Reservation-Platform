<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Code generated by openapi-generator is not ours to style. -->
    <suppress files="[\\/]target[\\/]generated-sources[\\/]" checks=".*"/>
    <!-- ArchUnit suites declare rules as static fields; JUnit must be able to instantiate them. -->
    <suppress files="ArchitectureTest\.java$" checks="HideUtilityClassConstructor"/>
</suppressions>
